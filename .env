# === Required Configuration ===
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_token_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token
OPENAI_API_KEY=your_openai_key
SENDER_WALLET_PUBKEY=your_solana_public_key
SENDER_WALLET_PRIVATE_KEY=your_solana_private_key

# Dashboard Security
DASHBOARD_SECRET_KEY=your-super-secret-key-here
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=strong-password-here
# DASHBOARD_PORT=8050

# Celery/RabbitMQ Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Airdrop Settings
MAX_AIRDROP_RETRIES=3
AIRDROP_COOLDOWN=300
AIRDROP_MAX_DAILY=100

# === Optional Configuration ===
# Solana Network
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# Transaction Settings
# COMPUTE_UNIT_LIMIT=200000
# PRIORITY_FEE_MICRO_LAMPORTS=500
# FALLBACK_FEE=5000
# MAX_RETRIES=5
# CONFIRMATION_TIMEOUT=300
# MIN_BALANCE_RESERVE=1000000000

# Meme Coin Settings
# MEME_COIN_SYMBOL=MEME
# MEME_COIN_NAME=MemeCoin
# AIRDROP_AMOUNT=1000000
# AIRDROP_PROBABILITY=0.1

# Monitoring & Notifications
# NOTIFICATION_WEBHOOK=https://your-webhook-url
# ALERT_WEBHOOK=https://your-alert-webhook
# ADMIN_EMAILS=admin@example.com

# Application Behavior
# DEBUG=true
# LOG_LEVEL=INFO
# HISTORY_RETENTION=86400
